# Copy to .env and fill in. Never commit .env.

# Audiobookshelf URL as reachable from the abs-stats container
ABS_URL=http://your-abs-host:13378
# API token for a dedicated admin user (e.g. "abs-stats") in Audiobookshelf
ABS_TOKEN=paste-your-token-here
# Seconds between syncs (default 30 minutes)
POLL_INTERVAL=1800
# Username of the service account, hidden from user stats
STATS_USERNAME=abs-stats

# Optional notifications. Leave blank to disable.
DISCORD_WEBHOOK_URL=
NTFY_URL=
